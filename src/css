/* variáveis (testando cores */
:root {
  --verde: #1f9d6b;
  --verde-escuro: #14684a;
  --texto: #1c2430;
  --texto-suave: #5b6675;
  --fundo: #f7f8f5;
  --branco: #ffffff;
  --borda: #e3e6e0;
  --raio: 12px;
}

/* base */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  color: var(--texto);
  background: var(--fundo);
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

/* Cabeçalho pra mobile */
.cabecalho {
  background: var(--branco);
  border-bottom: 1px solid var(--borda);
  position: sticky;
  top: 0;
  z-index: 10;
}

.cabecalho-conteudo {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 12px;
  padding-bottom: 12px;
}

.logo {
  font-size: 1.25rem;
  font-weight: 700;
}

.logo span {
  color: var(--verde);
}

/* menu rola para o lado no celular, sem quebrar o layout */
.navegacao {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  -webkit-overflow-scrolling: touch;
}

.navegacao a {
  flex-shrink: 0;
  padding: 10px 14px; 
  border-radius: 999px;
  font-size: 0.95rem;
  white-space: nowrap;
}

.navegacao a.ativo {
  background: #e6f4ee;
  color: var(--verde-escuro);
  font-weight: 700;
}

.navegacao a.botao-quiz {
  background: var(--verde);
  color: var(--branco);
  font-weight: 700;
}

/*mobile coluna*/
.hero {
  padding: 32px 0 48px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}

.rotulo {
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  font-weight: 700;
  color: var(--verde-escuro);
  margin-bottom: 12px;
}

h1 {
  font-size: clamp(2rem, 8vw, 3.5rem);
  line-height: 1.1;
  margin-bottom: 16px;
}

h1 span {
  display: block; /* cada frase em uma linha */
}

h1 .verde {
  color: var(--verde);
}

h2 {
  font-size: clamp(1.5rem, 5vw, 2.25rem);
  line-height: 1.2;
  margin-bottom: 16px;
}

h2 em {
  display: block;
  font-style: normal;
  color: var(--verde);
}

.descricao {
  font-size: 1.05rem;
  color: var(--texto-suave);
  max-width: 55ch;
  margin-bottom: 24px;
}

.acoes {
  display: flex;
  flex-direction: column; /* botões empilhados no celular */
  align-items: stretch;
  gap: 12px;
  margin-bottom: 16px;
}

.botao-principal {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  min-height: 48px;
  padding: 12px 24px;
  background: var(--verde);
  color: var(--branco);
  font-weight: 700;
  border-radius: var(--raio);
}

.botao-principal:hover {
  background: var(--verde-escuro);
}

.link-secundario {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  min-height: 48px;
  font-weight: 700;
  color: var(--verde-escuro);
}

.link-secundario:hover {
  text-decoration: underline;
}

.observacao {
  font-size: 0.9rem;
  color: var(--texto-suave);
}

.check {
  color: var(--verde);
  font-weight: 700;
  margin-right: 4px;
}

/* visual */
.preview {
  display: block;
  background: var(--branco);
  border: 1px solid var(--borda);
  border-radius: var(--raio);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}

.preview:hover {
  transform: translateY(-4px);
}

.preview-topo {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--borda);
  font-size: 0.8rem;
  color: var(--texto-suave);
}

.bolinhas {
  display: flex;
  gap: 6px;
}

.bolinhas span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--borda);
}

.preview img {
  width: 100%;
}

.preview-rodape {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px;
}

.preview-rodape strong {
  flex: 1;
}

.simbolo,
.seta {
  color: var(--verde);
}

.nota-visual {
  margin-top: 16px;
  font-size: 0.9rem;
  color: var(--texto-suave);
}

/* explorar */
.explorar {
  padding: 48px 0;
  background: var(--branco);
  border-top: 1px solid var(--borda);
}

/* telas de 768px pra cima até 1024px */
@media (min-width: 768px) {
  .container {
    padding: 0 32px;
  }

  .hero {
    padding: 56px 0 72px;
  }

  .acoes {
    flex-direction: row;
    align-items: center;
    gap: 24px;
  }

  .botao-principal {
    justify-content: flex-start;
  }

  .explorar {
    padding: 72px 0;
  }
}

/* telas de 1024px pra cima */
@media (min-width: 1024px) {
  .cabecalho-conteudo {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .navegacao {
    overflow: visible;
    padding-bottom: 0;
  }

  .hero {
    padding: 80px 0 96px;
  }

  .hero-grid {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 64px;
  }
}
